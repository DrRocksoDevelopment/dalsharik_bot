# Telegram
BOT_TOKEN=

# Logging
LOG_LEVEL=info
LOG_CHAT_ID=
LOG_FILE=logs/app.log

# Storage
DATA_DIR=data

# Admin (одобрение новых вопросов через inline-кнопки)
BOT_ADMIN_ID=

# OpenRouter (генерация вопросов и шоу)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Firecrawl — пре-поиск фактов при генерации.
# Ключ задан → облако api.firecrawl.dev; ключ не задан → локальный инстанс FIRECRAWL_BASE_URL.
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=http://localhost:3002

# Лимит времени на обработку одного update в Telegraf (по умолчанию 90с).
# /generate (темы → поиск фактов → генерация) может занимать больше — при необходимости увеличь.
# HANDLER_TIMEOUT_MS=1800000
